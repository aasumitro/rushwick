{
  "notes": "Raspberry Pi 5 build (docs/hardware/pi.md). Pulse widths and the oscillator are assumed until the bench calibration (PLAN-hardware P3); re-measure and update them on the real car.",
  "board": "raspberry-pi-5",
  "i2c": { "backend": "smbus2", "bus": 1, "address": 64 },
  "pwm": { "frequency_hz": 50, "oscillator_hz": 25000000 },
  "steering": { "channel": 0, "center_us": 1500, "left_us": 2000, "right_us": 1000 },
  "throttle": { "channel": 1, "neutral_us": 1500, "start_us": 1560, "full_us": 2000, "max_speed": 3.0 },
  "heartbeat": { "backend": "gpiozero", "pin": 17 },
  "stats": "vcgencmd",
  "onnx_providers": ["CPUExecutionProvider"]
}
